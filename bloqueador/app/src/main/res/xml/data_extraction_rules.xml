<?xml version="1.0" encoding="utf-8"?>
<!-- The settings, the lists and the history move to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="database" path="sossego.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="sossego.db" />
    </device-transfer>
</data-extraction-rules>
