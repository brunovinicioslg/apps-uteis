<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="tab_lists">Lists</string>

    <!-- Setup -->
    <string name="setup_title">Turn Sossego on</string>
    <string name="setup_text">To block calls, Android has to let Sossego screen your calls. It never listens to calls and does not use the internet.</string>
    <string name="setup_button">Turn on</string>
    <string name="setup_denied">Without this permission, Sossego cannot block calls.</string>
    <string name="no_telephony_title">This device does not receive calls</string>
    <string name="no_telephony_text">Android on this device has no call screening.</string>

    <!-- Status -->
    <string name="status_on">Blocking: %1$s</string>
    <string name="status_off">Blocking is off</string>
    <string name="status_off_text">Every call rings as usual.</string>
    <string name="status_schedule">By the schedule, until %1$s.</string>

    <!-- Modes -->
    <string name="mode_title">What to block</string>
    <string name="mode_off">Off</string>
    <string name="mode_off_summary">No call is blocked.</string>
    <string name="mode_blocklist">Block list</string>
    <string name="mode_blocklist_summary">Only numbers on the block list and the filters that are on.</string>
    <string name="mode_allowlist">Allow list only</string>
    <string name="mode_allowlist_summary">Everyone except the allow list and your contacts.</string>
    <string name="mode_block_all">Block everything</string>
    <string name="mode_block_all_summary">Every call, contacts included.</string>
    <string name="block_all_confirm_title">Block every call?</string>
    <string name="block_all_confirm_text">Nobody will be able to call you, not even family and contacts, until you change the mode. Emergency numbers keep working.</string>
    <string name="block_all_confirm_button">Block everything</string>

    <!-- Hints -->
    <string name="hint_allow">Allow</string>
    <string name="hint_decline_title">Contacts still ring</string>
    <string name="hint_decline_text">Android does not show contacts\' calls to call screening. To decline them too, let Sossego see when the phone rings and decline the call. They may ring for a moment before ending.</string>
    <string name="decline_denied">Without this permission, contacts\' calls keep ringing.</string>
    <string name="hint_contacts_title">Protect your contacts</string>
    <string name="hint_contacts_text">With access to your contacts, Sossego checks every number and never blocks someone you saved, on any phone.</string>
    <string name="contacts_denied">Without access to contacts, Sossego relies on Android not to screen them.</string>
    <string name="open_settings">Open</string>
    <string name="battery_title">Keep the system from stopping the blocking</string>
    <string name="battery_summary_xiaomi">On the app page, open Battery saver and choose No restrictions. Also turn on Autostart.</string>
    <string name="battery_summary_samsung">On the app page, open Battery and choose Unrestricted.</string>
    <string name="battery_button">Open settings</string>

    <!-- Filters -->
    <string name="filters_title">Block list filters</string>
    <string name="filter_telemarketing">Telemarketing (0303)</string>
    <string name="filter_telemarketing_summary">In Brazil, telemarketing may only call from 0303 numbers.</string>
    <string name="filter_hidden">Hidden numbers</string>
    <string name="filter_hidden_summary">Calls without a number (private or unknown).</string>
    <string name="filter_international">Calls from abroad</string>
    <string name="filter_international_summary">Numbers from outside Brazil.</string>
    <string name="repeat_title">Let someone who insists through</string>
    <string name="repeat_summary">If the same number calls again within 3 minutes, the second call rings. Useful in emergencies.</string>

    <!-- When blocking -->
    <string name="action_title">When blocking</string>
    <string name="action_what">What to do with the call</string>
    <string name="action_reject">Decline</string>
    <string name="action_silence">Silence</string>
    <string name="action_reject_summary">Declined without ringing. It may go to the carrier\'s voicemail.</string>
    <string name="action_silence_summary">Arrives without sound and ends as a missed call.</string>
    <string name="keep_log_title">Keep in the phone\'s call history</string>
    <string name="keep_log_summary">The blocked call shows in the Phone app.</string>
    <string name="notifications_title">Notifications</string>
    <string name="notify_none">None</string>
    <string name="notify_each">Every block</string>
    <string name="notify_daily">Daily summary</string>
    <string name="notifications_denied">Without notification permission, Sossego stays silent.</string>

