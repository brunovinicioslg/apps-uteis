<?xml version="1.0" encoding="utf-8"?>
<!-- Region files are large and can be imported again; only the settings are worth restoring. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
