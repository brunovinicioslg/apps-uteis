<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Bluetooth permissions are asked for at run time by LocalDevice.getLocalDevice(), which every
         Bluetooth path goes through first (including Connector.open for btspp/btl2cap); a refusal
         throws BluetoothStateException, as on a phone without Bluetooth. -->
    <issue id="MissingPermission">
        <ignore path="src/main/java/javax/bluetooth/**" />
        <ignore path="src/main/java/org/microemu/cldc/btl2cap/**" />
        <ignore path="src/main/java/org/microemu/cldc/btspp/**" />
        <ignore path="src/main/java/com/nokia/mid/ui/SoftNotificationImpl.java" />
    </issue>
    <!-- Nor notifications: Nokia's SoftNotification from a game is dropped by Android 13+. -->
    <issue id="NotificationPermission">
        <ignore path="src/main/java/com/nokia/mid/ui/SoftNotificationImpl.java" />
    </issue>
</lint>
