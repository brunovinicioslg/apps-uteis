<?xml version="1.0" encoding="utf-8"?>
<!-- Only the settings are worth restoring on a new phone; photos stay in the cache. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
